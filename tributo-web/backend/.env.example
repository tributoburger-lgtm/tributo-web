# Copiar como .env y completar valores reales

# Base de datos PostgreSQL (Railway genera esta variable automáticamente)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/tributo

# Clave secreta para JWT — genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-clave-segura-generada

# URL del frontend (para CORS)
FRONTEND_URL=https://tu-app.netlify.app

# Modo debug (False en producción)
DEBUG=False
